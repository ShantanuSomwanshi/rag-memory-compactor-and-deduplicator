{
  "workdir": ".ragcompactor",
  "collection": "memory",
  "store_backend": "chroma",
  "chunk_size": 900,
  "chunk_overlap": 120,
  "embedding_backend": "sentence-transformers",
  "embedding_model": "all-MiniLM-L6-v2",
  "embedding_dim": 384,
  "top_k": 10,
  "similarity_threshold": 0.85,
  "max_group_size": 8,
  "validation_threshold": 0.9,
  "refine_rejected_groups": true,
  "llm_backend": "litellm",
  "llm_model": "gpt-4o-mini",
  "llm_temperature": 0.1,
  "max_summary_tokens": 512,
  "llm_timeout": 60.0,
  "llm_num_retries": 5,
  "max_group_failures": 3,
  "llm_request_delay": 0.0,
  "token_model": "gpt-4o-mini"
}
