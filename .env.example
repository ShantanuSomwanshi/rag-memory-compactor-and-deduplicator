# Copy this file to .env and fill in the key for whichever provider your
# llm_model uses. .env is loaded automatically by every ragcompactor command,
# and is gitignored - it never gets committed.
#
# Only the key matching your configured model is needed.

# Groq        -> llm_model: "groq/openai/gpt-oss-120b" or "groq/llama-3.3-70b-versatile"
GROQ_API_KEY=

# OpenAI      -> llm_model: "gpt-4o-mini"
# OPENAI_API_KEY=

# Anthropic   -> llm_model: "claude-3-5-haiku-20241022"
# ANTHROPIC_API_KEY=

# Together    -> llm_model: "together_ai/..."
# TOGETHER_API_KEY=

# Ollama runs locally and needs no key at all:
#   llm_model: "ollama/llama3.2:3b"

# Optional: override the model without editing ragcompactor.json
# RAGCOMPACTOR_LLM_MODEL=groq/openai/gpt-oss-120b
