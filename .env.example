# LiteLLM routes on the model string, so set the key that matches your chosen model.
# Only one of these is needed.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...

# Optional: override the model used for the summarization step.
# Examples: gpt-4o-mini | claude-3-5-haiku-20241022 | groq/llama-3.1-8b-instant | ollama/llama3.2:3b
# RAGCOMPACTOR_LLM_MODEL=gpt-4o-mini
